{
  "inventory_container_item/item_cell/item": {

    "$item_collection_name":"$item_collection_name",

    "controls":[
      {
        "stack_count_label@common.stack_count_label": {
          "layer":10
        }
      },

      {
        "$item_renderer@$item_renderer": {
          "size":"$item_renderer_size",
          "anchor_to":"center",
          "anchor_from":"center",
          "offset":"$item_renderer_offset",
          "layer":7,

          "controls":[
            {
              "overlay@item_renderer_xenon.overlay": {
                "size": "$item_renderer_size",
                "anchor_to": "center",
                "anchor_from": "center",
                "offset": "$item_renderer_offset",
                "$item_layer": 1
              }
            }
          ]
        }
      }
    ]
  }
}