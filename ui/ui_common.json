{
  "container_item/item_cell/item": {
    "$renderer_binding_name|default": "#hover_text",
    "$renderer_binding_type|default": "collection",
    "$renderer_binding_collection_name|default": "$item_collection_name",

    "controls": [
      {
        "stack_count_label@common.stack_count_label": {
          "layer": 27
        }
      },

      {
        "$item_renderer@$item_renderer": {
          "size": "$item_renderer_size",
          "anchor_to": "center",
          "anchor_from": "center",
          "offset": "$item_renderer_offset",
          "layer": 7,

          "controls": [
            {
              "overlay@item_renderer_xenon.overlay": {
                "size": "$item_renderer_size",
                "anchor_to": "center",
                "anchor_from": "center",
                "offset": "$item_renderer_offset",
                "$item_layer": 1,
                "$item_collection_name": "$item_collection_name"
              }
            }
          ]
        }
      },
      {
        "durability_bar@$durability_bar_control": {
          "layer": 8
        }
      }
    ]
  }
}